# PostgreSQL (local development only)
POSTGRES_DB=travelos
POSTGRES_USER=travelos
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Platform API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:8080
ConnectionStrings__TravelOS=Host=localhost;Port=5432;Database=travelos;Username=travelos;Password=change-me-local-only
AiService__BaseUrl=http://localhost:8001\nJwt__Issuer=TravelOS\nJwt__Audience=TravelOS.Client\n# Local development placeholder only. Replace with a unique secret of 32+ bytes. Never reuse in production.\nJwt__SigningKey=local-development-only-change-this-key-to-a-random-64-character-secret

# AI service: demo provider only in Stage 1
AI_PROVIDER=demo
AI_PROVIDER_API_KEY=
