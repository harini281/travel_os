# PostgreSQL (local development only)
POSTGRES_DB=travelos
POSTGRES_USER=travelos
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Platform API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:8080
ConnectionStrings__TravelOS=Host=localhost;Port=5432;Database=travelos;Username=travelos;Password=change-me-local-only
AiService__BaseUrl=http://localhost:8001
Cors__AllowedOrigins__0=http://localhost:5173
Jwt__Issuer=TravelOS
Jwt__Audience=TravelOS.Client
# Local development placeholder only. Replace with a unique secret of 32+ bytes. Never reuse in production.
Jwt__SigningKey=local-development-only-change-this-key-to-a-random-64-character-secret

# AI service: demo by default. Use AI_PROVIDER=openai and configure OPENAI_API_KEY locally to enable generation.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
