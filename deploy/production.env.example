# Copy to deploy/production.env and replace every placeholder before deployment.
# Never commit deploy/production.env or share its contents.
POSTGRES_DB=travelos
POSTGRES_USER=travelos
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD
TRAVELOS_CONNECTION_STRING=Host=postgres;Port=5432;Database=travelos;Username=travelos;Password=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD
JWT_ISSUER=TravelOS
JWT_AUDIENCE=TravelOS.Client
JWT_SIGNING_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES
CORS_ALLOWED_ORIGIN=https://travelos.example.com
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_RECEIPT_PROVIDER=demo
FLIGHTAWARE_API_KEY=
