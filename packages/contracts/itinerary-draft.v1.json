{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelos.example/contracts/itinerary-draft.v1.json",
  "title": "TravelOS Generated Itinerary Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "days"],
  "properties": {
    "title": { "type": "string", "minLength": 2, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 2, "maxLength": 1000 },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 31,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dayNumber", "date", "theme", "activities"],
        "properties": {
          "dayNumber": { "type": "integer", "minimum": 1 },
          "date": { "type": "string", "format": "date" },
          "theme": { "type": "string", "minLength": 2, "maxLength": 160 },
          "activities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "description", "placeName", "latitude", "longitude", "durationMinutes", "estimatedCost", "currencyCode", "sortOrder"],
              "properties": {
                "title": { "type": "string", "minLength": 2, "maxLength": 180 },
                "description": { "type": ["string", "null"], "maxLength": 2000 },
                "placeName": { "type": ["string", "null"], "maxLength": 200 },
                "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
                "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
                "durationMinutes": { "type": ["integer", "null"], "minimum": 1 },
                "estimatedCost": { "type": ["number", "null"], "minimum": 0 },
                "currencyCode": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
                "sortOrder": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
